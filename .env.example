# ──────────────────────────────────────────────
# x402 LLM Gateway — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# All others have sensible defaults for testnet development.

# ── Node Environment ──────────────────────────
NODE_ENV=development

# ── Server ────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Stellar Network ───────────────────────────
# Options: testnet | mainnet | futurenet
STELLAR_NETWORK=testnet
# Override default Horizon/Soroban RPC endpoints:
# HORIZON_URL=https://horizon-testnet.stellar.org
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Database (PostgreSQL) [REQUIRED] ──────────
DATABASE_URL=postgresql://x402:x402_dev_password@localhost:5432/x402_gateway

# ── Redis [REQUIRED] ──────────────────────────
REDIS_URL=redis://localhost:6379

# ── Payment Configuration ─────────────────────
# Stellar USDC issuer address (default: testnet USDC)
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Quote expiry in seconds (default: 300 = 5 minutes)
QUOTE_EXPIRY_SECONDS=300
# Minimum payment amount in stroops (default: 10000 = 0.00001 XLM)
MIN_PAYMENT_AMOUNT=10000

# ── Security [REQUIRED for production] ────────
# JWT secret for dashboard sessions — MUST be at least 256 bits in production
# Generate: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production
# Session duration in seconds (default: 86400 = 24 hours)
SESSION_DURATION=86400
# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:3001

# ── Rate Limiting ─────────────────────────────
# Redis cache TTL for payment verification (default: 3600s)
PAYMENT_CACHE_TTL=3600
# Rate limit window in seconds (default: 60s)
RATE_LIMIT_WINDOW=60
# Max unpaid requests per window (default: 10)
RATE_LIMIT_MAX=10

# ── LLM Configuration ─────────────────────────
# Request timeout for non-streaming (default: 120000ms = 2 min)
LLM_REQUEST_TIMEOUT=120000
# Timeout for streaming requests (default: 600000ms = 10 min)
LLM_STREAM_TIMEOUT=600000
# Max retries for failed upstream calls (default: 2)
LLM_MAX_RETRIES=2

# ── Upstream LLM API Keys ─────────────────────
# Set per-provider using the pattern:
# UPSTREAM_API_KEY_<PROVIDER_ID_UPPERCASE_UNDERSCORED>
# Example: UPSTREAM_API_KEY_MY_PROVIDER_ID=sk-...

# ── Notifications (optional) ──────────────────
# Email
# EMAIL_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# EMAIL_FROM=gateway@example.com

# Webhooks
WEBHOOK_ENABLED=true
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY=1000

# ── Soroban Contracts ─────────────────────────
# Deployed contract IDs (defaults: testnet)
PAYMENT_VERIFIER_CONTRACT=CDHGI3A2BXRC5AQDPWEEXUDQMDXTDZYBCLJZWSE5XZKMVEGJ5LLHA4CZ
CREDIT_ESCROW_CONTRACT=CCE7AWVXPO57W5KDONOPMHDV4S5UBUBMHNJVSAVPL7AZGMD4WQN6WVAP
MULTISIG_CONTRACT=CDMBVMMNJVAJVAV3T2TAL2TAACGTKYUS45RXNLCYKYUC3VGHBI66NWAA
# Secret key for the contract admin (needed for on-chain payment recording)
# CONTRACT_ADMIN_SECRET=S...

# ── Dashboard (Next.js) ───────────────────────
# Gateway URL for the dashboard frontend
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
