# ═══════════════════════════════════════════════════════════════
# x402 LLM Gateway — Production Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ── Gateway (Railway) ──────────────────────────

# Database — Railway provides this automatically
DATABASE_URL=postgresql://x402:your-password@postgres:5432/x402_gateway
REDIS_URL=redis://redis:6379

# Stellar network
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Security — generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-64-byte-hex-string

# CORS — comma-separated list of allowed origins
# Must include your Vercel dashboard URL
CORS_ORIGINS=https://x402-dashboard.vercel.app,http://localhost:3001

# Upstream LLM API keys (optional, set per provider)
# UPSTREAM_API_KEY_E2E_PROVIDER_001=sk-...

# ── Dashboard (Vercel) ─────────────────────────

# Set this in Vercel dashboard: Project → Settings → Environment Variables
NEXT_PUBLIC_GATEWAY_URL=https://x402-gateway.your-team.railway.app

# ── Contracts (Stellar Testnet) ─────────────────

# Set this in GitHub Secrets or your local shell
# Fund a testnet account at https://laboratory.stellar.org
STELLAR_SECRET_KEY=S...
