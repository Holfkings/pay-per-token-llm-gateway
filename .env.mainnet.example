# ──────────────────────────────────────────────────────────────
# x402 LLM Gateway — MAINNET environment example
#
# ⚠️  MAINNET MOVES REAL USDC. Never deploy with test defaults, never
#     commit this file with real secrets, and keep the contract admin
#     secret key offline (hardware wallet / secret manager) whenever
#     possible.
#
# Copy to `.env` and fill in every value. The gateway fails fast when
# the required variables are missing.
#
#   cp .env.mainnet.example .env
# ──────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ── Database & Redis (mainnet deployments run their own) ──────
# Generate strong passwords:
#   openssl rand -base64 32
DATABASE_URL=postgresql://x402:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/x402_gateway
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# ── Stellar mainnet ───────────────────────────────────────────
STELLAR_NETWORK=mainnet

# Horizon / Soroban RPC default to the official mainnet endpoints
# when unset; uncomment to pin them explicitly:
# HORIZON_URL=https://horizon.stellar.org
# SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org

# Circle's official USDC issuer on Stellar mainnet. The gateway
# resolves this automatically from STELLAR_NETWORK — set it only to
# override (e.g. a bridged USDC variant).
USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# ── Security (REQUIRED) ───────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_to_a_random_256_bit_secret

# Secret key (S...) of the account that records on-chain payments.
# Its public key must be the admin of your deployed mainnet contracts.
# Store it in a secret manager; never in git.
CONTRACT_ADMIN_SECRET=CHANGE_ME_S...

# Comma-separated list of allowed dashboard origins.
CORS_ORIGINS=https://x402-dashboard.vercel.app

# Set to the actual proxy chain when behind Cloudflare/NGINX/Railway
# (e.g. TRUST_PROXY=loopback, or the proxy IP list). Used for IP-based
# rate limiting. See Express `trust proxy` docs.
# TRUST_PROXY=1

# ── Mainnet contract IDs (REQUIRED) ───────────────────────────
# Deploy with:
#   STELLAR_NETWORK=mainnet STELLAR_SECRET_KEY=S... \
#     USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN \
#     bash scripts/deploy-contracts.sh
# then copy the IDs from contracts/deployed-addresses.json (mainnet).
PAYMENT_VERIFIER_CONTRACT=CHANGE_ME_C...
CREDIT_ESCROW_CONTRACT=CHANGE_ME_C...
MULTISIG_CONTRACT=CHANGE_ME_C...

# ── Payments ──────────────────────────────────────────────────
# Minimum payment amount in stroops (default: 10000 = 0.00001 USDC).
# MIN_PAYMENT_AMOUNT=10000
# Quote expiry in seconds (default: 300).
# QUOTE_EXPIRY_SECONDS=300
# Opt-in per-token on-chain settlement via credit-escrow.
# ESCROW_SETTLEMENT_ENABLED=false

# ── Upstream LLM providers ────────────────────────────────────
# Define your providers/routes via the dashboard admin UI after the
# gateway is up. LLM provider API keys live there (encrypted at rest),
# not in this file.

# ── Notifications (optional) ──────────────────────────────────
# EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# WEBHOOK_ENABLED=true
# WEBHOOK_RETRY_COUNT=3
# WEBHOOK_RETRY_DELAY=1000
