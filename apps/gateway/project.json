{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/gateway/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/gateway", "{workspaceRoot}/dist/out-tsc"],
      "options": {
        "commands": [
          "npx tsc -p apps/gateway/tsconfig.app.json",
          "node scripts/bundle-gateway.mjs"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ts-node --project apps/gateway/tsconfig.json apps/gateway/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        // NODE_PATH points at the workspace package node_modules so the
        // bundle's external @prisma/client resolves (pnpm isolated layout).
        "command": "NODE_PATH=packages/database/node_modules:node_modules node dist/apps/gateway/main.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/gateway"],
      "options": {
        "jestConfig": "apps/gateway/jest.config.ts",
        "coverageReporters": ["html", "text"]
      }
    },
    "test:e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/gateway-e2e"],
      "options": {
        "jestConfig": "apps/gateway/jest.e2e.config.ts",
        "coverageReporters": ["html", "text"]
      }
    }
  }
}
