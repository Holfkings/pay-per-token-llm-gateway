{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/gateway/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/gateway"],
      "options": {
        "command": "npx tsc -p apps/gateway/tsconfig.app.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ts-node --project apps/gateway/tsconfig.json apps/gateway/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/out-tsc/apps/gateway/src/main.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/gateway"],
      "options": {
        "jestConfig": "apps/gateway/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "test:e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/gateway-e2e"],
      "options": {
        "jestConfig": "apps/gateway/jest.e2e.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
